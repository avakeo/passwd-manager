<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram name="00 凡例と描き方" id="p00"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p00v1" value="図の凡例と描き方" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="40" as="geometry"/></mxCell><mxCell id="p00v2" value="処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="90" height="30" as="geometry"/></mxCell><mxCell id="p00v3" value="データ・鍵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="80" width="90" height="30" as="geometry"/></mxCell><mxCell id="p00v4" value="保存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="90" height="30" as="geometry"/></mxCell><mxCell id="p00v5" value="D1 に保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="80" width="130" height="30" as="geometry"/></mxCell><mxCell id="p00v6" value="&lt;b&gt;A：暗号化の仕組み（処理図）&lt;/b&gt;&lt;br&gt;・通信は描かない。入力 → 処理 → 出力を描く&lt;br&gt;・処理は紫の四角、データと鍵はグレーの箱&lt;br&gt;・保存しないものは点線&lt;br&gt;・保存先（D1 など）は右端の枠にまとめ、保存するものだけ矢印を伸ばす&lt;br&gt;・流れが複数あるときは列を分け、合流する処理を一番下に置く&lt;br&gt;・箱の補足は短く（大きさ、取り出し可否、回数など）" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="520" height="190" as="geometry"/></mxCell><mxCell id="p00v7" value="&lt;b&gt;B：使用時の流れ（シーケンス図）&lt;/b&gt;&lt;br&gt;・登場人物を横に並べ、縦の点線（ライフライン）を下に伸ばす&lt;br&gt;・上から順に、誰から誰へ何が渡るかを矢印で描く&lt;br&gt;・矢印の上に渡るものを書き、色分けする&lt;br&gt;&amp;nbsp;&amp;nbsp;赤：平文　青：暗号文　灰：トークンや識別子&lt;br&gt;・サーバー側（Workers、D1）に赤い矢印が届いていないことを確認する&lt;br&gt;・暗号処理は「A-3 を実行」のような箱で書き、中身は A の図に任せる&lt;br&gt;・失敗したときの分岐（409、照合不一致など）も描く" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="520" height="190" as="geometry"/></mxCell><mxCell id="p00v8" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="360" width="1" height="1" as="geometry"/></mxCell><mxCell id="p00v9" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="360" width="1" height="1" as="geometry"/></mxCell><mxCell id="p00e10" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E24B4A;" edge="1" parent="1" source="p00v8" target="p00v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p00v11" value="平文" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="370" width="120" height="20" as="geometry"/></mxCell><mxCell id="p00v12" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="770" y="360" width="1" height="1" as="geometry"/></mxCell><mxCell id="p00v13" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="850" y="360" width="1" height="1" as="geometry"/></mxCell><mxCell id="p00e14" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#378ADD;" edge="1" parent="1" source="p00v12" target="p00v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p00v15" value="暗号文" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="370" width="120" height="20" as="geometry"/></mxCell><mxCell id="p00v16" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="360" width="1" height="1" as="geometry"/></mxCell><mxCell id="p00v17" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1020" y="360" width="1" height="1" as="geometry"/></mxCell><mxCell id="p00e18" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#888780;" edge="1" parent="1" source="p00v16" target="p00v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p00v19" value="トークン・識別子" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="370" width="120" height="20" as="geometry"/></mxCell><mxCell id="p00v20" value="&lt;b&gt;レビューの観点&lt;/b&gt;&lt;br&gt;1. E2EE の境界：サーバーに平文や鍵が渡っていないか&lt;br&gt;2. 確認の漏れ：オリジン照合、鍵の固定、リビジョン確認など&lt;br&gt;3. 順番：承認とグラントが同時か、確認がバッチの先頭か&lt;br&gt;4. 失敗時：途中で失敗しても半端な状態が残らないか&lt;br&gt;5. 仕様書との一致&lt;br&gt;6. A の処理がすべて B のどこかで呼ばれているか、B の暗号処理がすべて A に対応しているか" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="1080" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A-1 鍵ペアの生成と保存" id="pA1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pA1v1" value="A-1 鍵ペアの生成と保存" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="500" height="30" as="geometry"/></mxCell><mxCell id="pA1v2" value="パスワードの流れ" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA1v3" value="鍵ペアの流れ" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA1v4" value="D1 に保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F6E56;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#085041;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="190" height="580" as="geometry"/></mxCell><mxCell id="pA1v5" value="マスターパスワード&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;利用者が覚える&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v6" value="PBKDF2&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;SHA-256・60万回&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v7" value="ソルト&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;16バイトの乱数&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v8" value="マスターキー&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;32バイト&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v9" value="HKDF&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;用途ラベルで派生&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v10" value="鍵ペア生成&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;乱数から（P-256）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="340" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v11" value="ラップ鍵&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;取り出し不可&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v12" value="秘密鍵&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;生成時のみ取り出し可&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="430" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v13" value="PKCS#8で書き出し&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;138バイトの平文&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="260" y="520" width="180" height="56" as="geometry"/></mxCell><mxCell id="pA1v14" value="ノンス・AAD&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;乱数12バイト・鍵ID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="150" height="56" as="geometry"/></mxCell><mxCell id="pA1v15" value="AES-GCM で暗号化&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2本の流れが合流&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="220" y="610" width="200" height="56" as="geometry"/></mxCell><mxCell id="pA1v16" value="ソルト・KDF設定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="166" width="150" height="44" as="geometry"/></mxCell><mxCell id="pA1v17" value="公開鍵&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;65バイト&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="340" width="150" height="56" as="geometry"/></mxCell><mxCell id="pA1v18" value="暗号化した秘密鍵&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ノンス・鍵IDも&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="610" width="150" height="56" as="geometry"/></mxCell><mxCell id="pA1e19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v5" target="pA1v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v7" target="pA1v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v7" target="pA1v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v6" target="pA1v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v8" target="pA1v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v9" target="pA1v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v10" target="pA1v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v10" target="pA1v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v12" target="pA1v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v13" target="pA1v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v14" target="pA1v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v15" target="pA1v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pA1e31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#444441;" edge="1" parent="1" source="pA1v11" target="pA1v15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="590"/><mxPoint x="270" y="590"/></Array></mxGeometry></mxCell><mxCell id="pA1v32" value="処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA1v33" value="データ・鍵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="700" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA1v34" value="保存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="700" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA1v35" value="D1 に保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="700" width="130" height="30" as="geometry"/></mxCell><mxCell id="pA1v36" value="&lt;b&gt;確認&lt;/b&gt;&lt;br&gt;・点線の箱から D1 への矢印がない＝E2EE&lt;br&gt;・ソルトは PBKDF2 と D1 の両方へ（ロック解除で同じ鍵を作り直すため）&lt;br&gt;・フィンガープリント（公開鍵の SHA-256）は承認時に表示するだけで保存しない&lt;br&gt;・秘密鍵は暗号化したらメモリから破棄" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="420" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A-2 Vault 鍵を包む（HPKE 送信側）" id="pA2"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pA2v1" value="A-2 Vault 鍵を包む（HPKE 送信側）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="pA2v2" value="Vault 鍵の流れ" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA2v3" value="受け手の公開鍵と鍵交換" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA2v4" value="D1 に保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F6E56;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#085041;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="190" height="500" as="geometry"/></mxCell><mxCell id="pA2v5" value="（ここに描く）" style="text;html=1;align=center;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="400" height="30" as="geometry"/></mxCell><mxCell id="pA2v6" value="処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA2v7" value="データ・鍵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA2v8" value="保存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA2v9" value="D1 に保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="620" width="130" height="30" as="geometry"/></mxCell><mxCell id="pA2v10" value="&lt;b&gt;入力&lt;/b&gt;&lt;br&gt;・Vault 鍵（グラントを取り出し可で開き直したもの）&lt;br&gt;・受け手の公開鍵&lt;br&gt;・info（鍵の世代、宛先の鍵 ID）&lt;br&gt;&lt;br&gt;&lt;b&gt;処理の順番&lt;/b&gt;&lt;br&gt;1. 受け手の公開鍵を固定値と照合（違えば中止）&lt;br&gt;2. 使い捨て鍵ペアを生成&lt;br&gt;3. ECDH（使い捨て秘密鍵 × 受け手の公開鍵）→ 共有秘密&lt;br&gt;4. HPKE の鍵スケジュール（HKDF）→ 包み用の鍵&lt;br&gt;5. AES-GCM で Vault 鍵を暗号化&lt;br&gt;&lt;br&gt;&lt;b&gt;出力（D1 に保存）&lt;/b&gt;&lt;br&gt;・使い捨て公開鍵&lt;br&gt;・包まれた Vault 鍵（＝グラント）&lt;br&gt;&lt;br&gt;&lt;b&gt;保存しない&lt;/b&gt;&lt;br&gt;・使い捨て秘密鍵、共有秘密、包み用の鍵&lt;br&gt;・Vault 鍵の平文&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;&lt;br&gt;照合の失敗を分岐として描く。RFC 9180 の Base モードに準拠" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="430" height="500" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A-3 ロック解除（復号の連鎖）" id="pA3"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pA3v1" value="A-3 ロック解除（復号の連鎖）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="pA3v2" value="パスワードの流れ" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA3v3" value="D1 から取得したもの" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA3v4" value="メモリ（Service Worker）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F6E56;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#085041;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="190" height="500" as="geometry"/></mxCell><mxCell id="pA3v5" value="（ここに描く）" style="text;html=1;align=center;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="400" height="30" as="geometry"/></mxCell><mxCell id="pA3v6" value="処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA3v7" value="データ・鍵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA3v8" value="保存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA3v9" value="メモリ（Service Worker）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="620" width="130" height="30" as="geometry"/></mxCell><mxCell id="pA3v10" value="&lt;b&gt;入力&lt;/b&gt;&lt;br&gt;・マスターパスワード（頭の中）&lt;br&gt;・ソルトと KDF 設定（D1）&lt;br&gt;・暗号化した秘密鍵とノンス（D1）&lt;br&gt;・自分宛てのグラント（D1）&lt;br&gt;&lt;br&gt;&lt;b&gt;処理の順番&lt;/b&gt;&lt;br&gt;1. KDF 設定が下限以上か確認&lt;br&gt;2. PBKDF2 → マスターキー&lt;br&gt;3. HKDF → ラップ鍵&lt;br&gt;4. AES-GCM で秘密鍵を復号（AAD も確認）&lt;br&gt;5. 秘密鍵を取り出し不可で読み込む&lt;br&gt;6. ECDH（自分の秘密鍵 × 使い捨て公開鍵）→ HPKE で開封&lt;br&gt;7. Vault 鍵を取り出し不可で読み込む&lt;br&gt;&lt;br&gt;&lt;b&gt;出力（メモリ（Service Worker））&lt;/b&gt;&lt;br&gt;・秘密鍵（取り出し不可）&lt;br&gt;・Vault 鍵（取り出し不可）&lt;br&gt;&lt;br&gt;&lt;b&gt;保存しない&lt;/b&gt;&lt;br&gt;・マスターパスワード、マスターキー、ラップ鍵&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;&lt;br&gt;失敗分岐：パスワード違い → 認証タグの検証で失敗／KDF 設定が下限未満 → 拒否。A-1 を逆にたどる形になる" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="430" height="500" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A-4 アイテムの暗号化と復号" id="pA4"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pA4v1" value="A-4 アイテムの暗号化と復号" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="pA4v2" value="平文のアイテム" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA4v3" value="鍵と AAD" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA4v4" value="D1 に保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F6E56;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#085041;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="190" height="500" as="geometry"/></mxCell><mxCell id="pA4v5" value="（ここに描く）" style="text;html=1;align=center;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="400" height="30" as="geometry"/></mxCell><mxCell id="pA4v6" value="処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA4v7" value="データ・鍵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA4v8" value="保存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA4v9" value="D1 に保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="620" width="130" height="30" as="geometry"/></mxCell><mxCell id="pA4v10" value="&lt;b&gt;入力&lt;/b&gt;&lt;br&gt;・アイテムの JSON（種類、名前、ユーザー名、パスワード、URL、メモ、カスタム項目）&lt;br&gt;・Vault 鍵&lt;br&gt;・アイテム ID、鍵の世代&lt;br&gt;&lt;br&gt;&lt;b&gt;処理の順番&lt;/b&gt;&lt;br&gt;1. JSON にまとめる&lt;br&gt;2. パディング（512B、1KB、4KB、16KB、64KB のどれかに揃える）&lt;br&gt;3. ノンス（12バイトの乱数）を生成&lt;br&gt;4. AES-GCM（AAD ＝ 形式、アイテム ID、鍵の世代）&lt;br&gt;&lt;br&gt;&lt;b&gt;出力（D1 に保存）&lt;/b&gt;&lt;br&gt;・items の暗号文の列（形式バージョン、ノンス、暗号文、認証タグ）&lt;br&gt;&lt;br&gt;&lt;b&gt;保存しない&lt;/b&gt;&lt;br&gt;・アイテムの平文&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;&lt;br&gt;復号は逆順。改ざんや AAD の不一致（別のアイテムの場所に移された）で失敗する分岐も描く" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="430" height="500" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="A-5 クイックロック解除" id="pA5"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pA5v1" value="A-5 クイックロック解除" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="pA5v2" value="パスコードの流れ" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA5v3" value="Vault 鍵" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#5F5E5A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="260" y="45" width="180" height="20" as="geometry"/></mxCell><mxCell id="pA5v4" value="chrome.storage.session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0F6E56;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#085041;arcSize=6;" vertex="1" parent="1"><mxGeometry x="480" y="90" width="190" height="500" as="geometry"/></mxCell><mxCell id="pA5v5" value="（ここに描く）" style="text;html=1;align=center;fontColor=#888780;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="400" height="30" as="geometry"/></mxCell><mxCell id="pA5v6" value="処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#534AB7;fontColor=#3C3489;arcSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA5v7" value="データ・鍵" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;" vertex="1" parent="1"><mxGeometry x="150" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA5v8" value="保存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#2C2C2A;arcSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="260" y="620" width="90" height="30" as="geometry"/></mxCell><mxCell id="pA5v9" value="chrome.storage.session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;arcSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="620" width="130" height="30" as="geometry"/></mxCell><mxCell id="pA5v10" value="&lt;b&gt;入力&lt;/b&gt;&lt;br&gt;・4桁のパスコード&lt;br&gt;・端末ごとのソルト&lt;br&gt;・Vault 鍵（取り出し可で開き直したもの）&lt;br&gt;&lt;br&gt;&lt;b&gt;処理の順番&lt;/b&gt;&lt;br&gt;&lt;b&gt;設定時&lt;/b&gt;&lt;br&gt;1. PBKDF2（パスコード、ソルト）→ 鍵&lt;br&gt;2. AES-GCM で Vault 鍵を暗号化&lt;br&gt;&lt;b&gt;復帰時&lt;/b&gt;&lt;br&gt;3. パスコードから同じ鍵を作り、復号&lt;br&gt;4. Vault 鍵を取り出し不可で読み込む&lt;br&gt;&lt;br&gt;&lt;b&gt;出力（chrome.storage.session）&lt;/b&gt;&lt;br&gt;・暗号化した Vault 鍵&lt;br&gt;・失敗回数&lt;br&gt;&lt;br&gt;&lt;b&gt;保存しない&lt;/b&gt;&lt;br&gt;・パスコード、パスコード由来の鍵&lt;br&gt;・秘密鍵（管理操作は常にマスターパスワード）&lt;br&gt;・サーバーには何も送らない&lt;br&gt;&lt;br&gt;&lt;b&gt;注意&lt;/b&gt;&lt;br&gt;5回失敗・放置・ブラウザ終了で保存を消去する分岐を描く" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="430" height="500" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-1 初回セットアップ（管理者）" id="pB1"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB1v1" value="B-1 初回セットアップ（管理者）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB1v2" value="管理者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB1v3" value="拡張機能" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB1v4" value="Discord" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB1v5" value="Workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB1v6" value="D1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB1v7" value="認証アプリ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="815" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB1v8" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;1. Discord でログイン（B-2）&lt;br&gt;2. TOTP の登録：QR を認証アプリで読み取り、コードを1回入力、回復コードを受け取る&lt;br&gt;3. マスターパスワードを設定（再入力、救済がないことの表示）&lt;br&gt;4. A-1 で鍵ペアを作り、公開鍵・暗号化した秘密鍵・ソルトを D1 へ&lt;br&gt;5. Vault 鍵（世代1）を生成&lt;br&gt;6. A-2 で自分宛てに包み、グラントを D1 へ&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;A-1、A-2" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1080" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-2 ログインとセッション" id="pB2"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB2v1" value="B-2 ログインとセッション" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB2v2" value="利用者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB2v3" value="拡張機能" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB2v4" value="Discord" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB2v5" value="Workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB2v6" value="Bot" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB2v7" value="D1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="815" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB2v8" value="認証アプリ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="970" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB2v9" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;1. 拡張機能が state と PKCE を生成&lt;br&gt;2. identity API で Discord の認可画面を開く&lt;br&gt;3. 認可コードがリダイレクトで戻る。state を確認&lt;br&gt;4. 認可コードと PKCE の検証値を Workers へ&lt;br&gt;5. Workers がクライアントシークレットでトークン交換（シークレットは Workers の外に出ない）&lt;br&gt;6. Bot でロールを確認、D1 で承認済みか確認&lt;br&gt;7. TOTP のコードを確認&lt;br&gt;8. 自前のアクセストークンとリフレッシュトークンを発行。D1 にはハッシュだけ&lt;br&gt;失敗分岐：state 不一致、ロールなし、TOTP 違い&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;なし" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1080" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-3 ロック解除" id="pB3"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB3v1" value="B-3 ロック解除" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB3v2" value="利用者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB3v3" value="拡張機能（Service Worker）" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB3v4" value="Workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB3v5" value="D1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB3v6" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;&lt;b&gt;マスターパスワードで解除&lt;/b&gt;&lt;br&gt;1. マスターパスワードを入力&lt;br&gt;2. D1 から鍵情報（ソルト、KDF 設定、暗号化した秘密鍵）とグラントを取得&lt;br&gt;3. A-3 を実行&lt;br&gt;4. 秘密鍵と Vault 鍵がメモリに乗る&lt;br&gt;5. 設定していれば A-5 でクイックロック解除の保存を作る&lt;br&gt;&lt;br&gt;&lt;b&gt;パスコードで復帰&lt;/b&gt;&lt;br&gt;6. Service Worker 停止後、4桁を入力 → A-5 で復帰&lt;br&gt;失敗分岐：パスワード違い、5回失敗で保存消去&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;A-3、A-5" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="450" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-4 アイテムの保存と同期" id="pB4"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB4v1" value="B-4 アイテムの保存と同期" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB4v2" value="利用者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB4v3" value="拡張機能" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB4v4" value="Workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB4v5" value="D1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB4v6" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;&lt;b&gt;保存&lt;/b&gt;&lt;br&gt;1. A-4 で暗号化&lt;br&gt;2. リビジョン付きで送信&lt;br&gt;3. 一致すれば保存し、リビジョンと Vault リビジョンを1増やす&lt;br&gt;4. 不一致なら 409 → 最新を取り直して再編集&lt;br&gt;&lt;br&gt;&lt;b&gt;同期&lt;/b&gt;&lt;br&gt;5. 差分を取得（更新日時の索引）&lt;br&gt;6. Vault リビジョンが既知より古ければ同期を止めて警告&lt;br&gt;7. A-4 で復号、削除済みはキャッシュから消す&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;A-4" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="450" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-5 自動入力とコピー" id="pB5"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB5v1" value="B-5 自動入力とコピー" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB5v2" value="利用者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB5v3" value="ポップアップ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB5v4" value="Service Worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB5v5" value="注入スクリプト" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB5v6" value="Web ページ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB5v7" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;1. ポップアップでアイテムを選ぶ&lt;br&gt;2. Service Worker がタブのオリジン（https、ホスト、ポート）とアイテムの URL を照合&lt;br&gt;3. 一致すればタブ・トップフレーム・文書 ID を指定して注入&lt;br&gt;4. 注入スクリプトが入力直前にオリジンを再確認&lt;br&gt;5. 対象の1件だけを受け取って入力&lt;br&gt;失敗分岐：不一致・HTTP・iframe → 入力しない（コピーで代替）&lt;br&gt;コピー：1分後、中身が同じなら消去&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;A-4（復号）" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1080" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-6 メンバー参加と承認" id="pB6"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB6v1" value="B-6 メンバー参加と承認" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB6v2" value="メンバー" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB6v3" value="メンバーの拡張機能" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB6v4" value="Workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB6v5" value="D1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB6v6" value="管理者の拡張機能" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB6v7" value="管理者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="815" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB6v8" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;1. メンバーがログイン（B-2）&lt;br&gt;2. A-1 で鍵ペアを作り、公開鍵を登録。状態は承認待ち&lt;br&gt;3. 管理者が承認画面でフィンガープリントを表示&lt;br&gt;4. Discord 以外の経路（対面・電話）でメンバーの画面と照合（図では枠外の点線で描く）&lt;br&gt;5. 照合済みの公開鍵を管理者の端末に固定&lt;br&gt;6. A-2 でメンバー宛てに包む&lt;br&gt;7. 承認とグラントを1つのリクエストで送り、同時に保存&lt;br&gt;失敗分岐：フィンガープリント不一致 → 承認しない&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;A-1（メンバー側）、A-2（管理者側）" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1080" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-7 ローテーション" id="pB7"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB7v1" value="B-7 ローテーション" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB7v2" value="管理者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB7v3" value="拡張機能" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB7v4" value="Workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB7v5" value="D1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB7v6" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;1. 管理者がメンバーを削除し、そのセッションを無効化&lt;br&gt;2. Vault リビジョン、全アイテム、有効なメンバーの公開鍵を取得&lt;br&gt;3. 公開鍵を固定値と照合&lt;br&gt;4. 新しい Vault 鍵を生成、A-4 で全アイテムを再暗号化、A-2 で全員分を包む&lt;br&gt;5. 1回のリクエストで送信&lt;br&gt;6. バッチの先頭で rotation_guard による確認（Vault リビジョン、アイテムの集合、メンバーの集合）&lt;br&gt;7. 一致すれば全部書き込み、不一致なら全体を巻き戻して 409&lt;br&gt;8. 大きすぎれば 413&lt;br&gt;9. 実サービス側のパスワード変更対象を一覧表示&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;A-2、A-4" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="450" height="560" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="B-8 パスワード変更と紛失時の復旧" id="pB8"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pB8v1" value="B-8 パスワード変更と紛失時の復旧" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="pB8v2" value="利用者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB8v3" value="拡張機能" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="195" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB8v4" value="Workers" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB8v5" value="D1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="505" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB8v6" value="管理者" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F1EFE8;strokeColor=#5F5E5A;size=50;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="140" height="560" as="geometry"/></mxCell><mxCell id="pB8v7" value="&lt;b&gt;描く手順&lt;/b&gt;&lt;br&gt;&lt;b&gt;マスターパスワード変更（鍵ペアは変わらない）&lt;/b&gt;&lt;br&gt;1. A-3 で秘密鍵を復号&lt;br&gt;2. 新しいソルトでラップ鍵を作り、秘密鍵を暗号化し直す（A-1 の暗号化部分だけ）&lt;br&gt;3. 楽観的ロック付きで更新。再承認もローテーションも不要&lt;br&gt;&lt;br&gt;&lt;b&gt;メンバーの紛失（鍵ペアが変わる）&lt;/b&gt;&lt;br&gt;4. 古い鍵を無効化、A-1 で新しい鍵ペア → 承認待ち → B-6 の管理者手順&lt;br&gt;&lt;br&gt;&lt;b&gt;管理者の紛失&lt;/b&gt;&lt;br&gt;5. D1 を直接編集して一時管理者を立てる → 新しい鍵で再登録 → 一時管理者が照合して包み直す → 元に戻す&lt;br&gt;&lt;br&gt;&lt;b&gt;呼ぶ A の処理&lt;/b&gt;&lt;br&gt;A-1、A-2、A-3" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#888780;fontColor=#2C2C2A;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="1080" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>